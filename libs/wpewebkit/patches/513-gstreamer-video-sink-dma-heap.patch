+#if OS(LINUX)
+// The decoder's own CONTEXT query reaches the video sink only once playbin3 has linked them.
+bool MediaPlayerPrivateGStreamer::answerDmaHeapContext(GstElement* element)
+{
+    GRefPtr<GstElement> videoSink = m_holePunchVideoSinkBin ? m_holePunchVideoSinkBin : m_videoSink;
+    if (!videoSink)
+        return false;
+
+    GRefPtr sinkPad = adoptGRef(gst_element_get_static_pad(videoSink.get(), "sink"));
+    if (!sinkPad)
+        return false;
+
+    GRefPtr query = adoptGRef(gst_query_new_context(WEBKIT_DMA_HEAP_CONTEXT_TYPE_NAME.characters()));
+    if (!gst_pad_query(sinkPad.get(), query.get()))
+        return false;
+
+    GstContext* context = nullptr;
+    gst_query_parse_context(query.get(), &context);
+    if (!context)
+        return false;
+
+    gst_element_set_context(element, context);
+    return true;
+}
