+// The compositor keeps the frame it shows and the one waiting to replace it (CoordinatedPlatformLayerBufferProxy).
+static constexpr unsigned compositorHeldFrames = 2;
+
+static bool canImportFromDmaHeap(const CString& device)
+{
+    auto& display = PlatformDisplay::sharedDisplay();
+    if (!display.eglExtensions().EXT_image_dma_buf_import)
+        return false;
+
+    GRefPtr<GstAllocator> allocator = createDmaHeapAllocator(device);
+    if (!allocator)
+        return false;
+
+    // One page as a single XRGB8888 row: a heap hands out whole pages, and a pitch of one page meets
+    // any pitch alignment an importer asks for.
+    static constexpr long bytesPerPixel = 4;
+    long pageSize = sysconf(_SC_PAGESIZE);
+    GstMemory* memory = gst_allocator_alloc(allocator.get(), pageSize, nullptr);
+    if (!memory)
+        return false;
+
+    DMABufBuffer::Attributes attributes;
+    attributes.size = IntSize(static_cast<int>(pageSize / bytesPerPixel), 1);
+    attributes.fourcc = FourCC(DRM_FORMAT_XRGB8888);
+    attributes.fds.append(WTF::UnixFileDescriptor { gst_dmabuf_memory_get_fd(memory), WTF::UnixFileDescriptor::Duplicate });
+    attributes.offsets.append(0);
+    attributes.strides.append(static_cast<uint32_t>(pageSize));
+    attributes.modifier = DRM_FORMAT_MOD_LINEAR;
+
+    auto image = DMABufBuffer::createEGLImage(display.glDisplay(), attributes);
+    gst_memory_unref(memory);
+    if (!image)
+        return false;
+
+    display.glDisplay().destroyImage(image);
+    return true;
+}
+
+static const CString& importableDmaHeapDevice()
+{
+    static NeverDestroyed<CString> device;
+    static std::once_flag onceFlag;
+    std::call_once(onceFlag, [] {
+        for (auto& candidate : dmaHeapDevices()) {
+            if (!canImportFromDmaHeap(candidate))
+                continue;
+
+            GST_INFO("EGL imports dma-bufs from %s", candidate.data());
+            device.get() = candidate;
+            return;
+        }
+    });
+    return device.get();
+}
+
+static unsigned webKitGLVideoSinkHeldFrames(WebKitGLVideoSink* sink)
+{
+    auto* priv = sink->priv;
+    guint queuedFrames;
+    guint pendingFrames;
+    g_object_get(priv->queue.get(), "max-size-buffers", &queuedFrames, nullptr);
+    g_object_get(priv->appSink.get(), "max-buffers", &pendingFrames, nullptr);
+    return queuedFrames + pendingFrames + compositorHeldFrames;
+}
+
+static GstPadProbeReturn webKitGLVideoSinkDmaHeapProbe(GstPad* pad, GstPadProbeInfo* info, gpointer)
+{
+    auto* query = GST_PAD_PROBE_INFO_QUERY(info);
+    bool isPushPhase = GST_PAD_PROBE_INFO_TYPE(info) & GST_PAD_PROBE_TYPE_PUSH;
+
+    if (isPushPhase ? !isDmaHeapContextQuery(query) : GST_QUERY_TYPE(query) != GST_QUERY_ALLOCATION)
+        return GST_PAD_PROBE_OK;
+
+    GRefPtr sink = adoptGRef(gst_pad_get_parent_element(pad));
+    if (!sink)
+        return GST_PAD_PROBE_OK;
+
+    if (isPushPhase) {
+        const auto& device = importableDmaHeapDevice();
+        if (device.isNull())
+            return GST_PAD_PROBE_OK;
+
+        GRefPtr<GstContext> context = createDmaHeapContext({ device, webKitGLVideoSinkHeldFrames(WEBKIT_GL_VIDEO_SINK(sink.get())) });
+        gst_query_set_context(query, context.get());
+        GST_PAD_PROBE_INFO_FLOW_RETURN(info) = GST_FLOW_OK;
+        return GST_PAD_PROBE_HANDLED;
+    }
+
+    // Upstream pools need as many buffers as this sink can hold before it lets one go.
+    gst_query_add_allocation_pool(query, nullptr, 0, webKitGLVideoSinkHeldFrames(WEBKIT_GL_VIDEO_SINK(sink.get())), 0);
+    return GST_PAD_PROBE_OK;
+}
 #endif
 
