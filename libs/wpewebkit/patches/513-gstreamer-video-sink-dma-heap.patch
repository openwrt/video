+namespace WebCore {
+
+// A video sink answers a CONTEXT query of this type with the dma-heap ("device", a /dev/dma_heap
+// path) whose buffers the element showing its frames can import, and the number of frames it holds
+// before it lets one go ("held-frames", a uint).
+static constexpr auto WEBKIT_DMA_HEAP_CONTEXT_TYPE_NAME = "webkit.dma-heap"_s;
+
+struct DmaHeapContext {
+    CString device;
+    unsigned heldFrames { 0 };
+};
+
+GRefPtr<GstContext> createDmaHeapContext(const DmaHeapContext&);
+std::optional<DmaHeapContext> dmaHeapFromContext(GstContext*);
+bool isDmaHeapContextQuery(GstQuery*);
+
+Vector<CString> dmaHeapDevices();
+GRefPtr<GstAllocator> createDmaHeapAllocator(const CString& device);
+
+} // namespace WebCore
