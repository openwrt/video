+#include "config.h"
+#include "GStreamerDmaHeap.h"
+
+#if USE(GSTREAMER) && OS(LINUX)
+
+#include "GStreamerCommon.h"
+#include <algorithm>
+#include <fcntl.h>
+#include <gst/allocators/gstdmabuf.h>
+#include <linux/dma-heap.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#include <wtf/FileSystem.h>
+#include <wtf/glib/WTFGType.h>
+#include <wtf/text/StringView.h>
+
+GST_DEBUG_CATEGORY_STATIC(webkit_dma_heap_debug);
+#define GST_CAT_DEFAULT webkit_dma_heap_debug
+
+struct WebKitDmaHeapAllocatorPrivate {
+    ~WebKitDmaHeapAllocatorPrivate()
+    {
+        if (heapFd >= 0)
+            close(heapFd);
+    }
+
+    int heapFd { -1 };
+};
+
+typedef struct {
+    GstDmaBufAllocator parent;
+    WebKitDmaHeapAllocatorPrivate* priv;
+} WebKitDmaHeapAllocator;
+
+typedef struct {
+    GstDmaBufAllocatorClass parentClass;
+} WebKitDmaHeapAllocatorClass;
+
+GType webkit_dma_heap_allocator_get_type();
+
+WEBKIT_DEFINE_TYPE_WITH_CODE(WebKitDmaHeapAllocator, webkit_dma_heap_allocator, GST_TYPE_DMABUF_ALLOCATOR,
+    GST_DEBUG_CATEGORY_INIT(webkit_dma_heap_debug, "webkitdmaheap", 0, "WebKit dma-heap allocator"))
+
+static GstMemory* webkitDmaHeapAllocatorAlloc(GstAllocator* allocator, gsize size, GstAllocationParams*)
+{
+    auto* self = reinterpret_cast<WebKitDmaHeapAllocator*>(allocator);
+    struct dma_heap_allocation_data allocation = { };
+
+    allocation.len = size;
+    allocation.fd_flags = O_RDWR | O_CLOEXEC;
+    if (ioctl(self->priv->heapFd, DMA_HEAP_IOCTL_ALLOC, &allocation) < 0) {
+        GST_WARNING_OBJECT(allocator, "cannot allocate %" G_GSIZE_FORMAT " bytes: %s", size, g_strerror(errno));
+        return nullptr;
+    }
+    // A pooled buffer is mapped once per frame; mapping a heap buffer remaps every page of it.
+    return gst_dmabuf_allocator_alloc_with_flags(allocator, allocation.fd, size, GST_FD_MEMORY_FLAG_KEEP_MAPPED);
+}
+
+static void webkitDmaHeapAllocatorConstructed(GObject* object)
+{
+    G_OBJECT_CLASS(webkit_dma_heap_allocator_parent_class)->constructed(object);
+
+    // GstFdAllocator only wraps descriptors it is given; this one allocates them itself.
+    GST_OBJECT_FLAG_UNSET(object, GST_ALLOCATOR_FLAG_CUSTOM_ALLOC);
+}
+
+static void webkit_dma_heap_allocator_class_init(WebKitDmaHeapAllocatorClass* klass)
+{
+    G_OBJECT_CLASS(klass)->constructed = webkitDmaHeapAllocatorConstructed;
+    GST_ALLOCATOR_CLASS(klass)->alloc = webkitDmaHeapAllocatorAlloc;
+}
+
+namespace WebCore {
+
+GRefPtr<GstContext> createDmaHeapContext(const DmaHeapContext& heap)
+{
+    GRefPtr context = adoptGRef(gst_context_new(WEBKIT_DMA_HEAP_CONTEXT_TYPE_NAME.characters(), FALSE));
+    gst_structure_set(gst_context_writable_structure(context.get()), "device", G_TYPE_STRING, heap.device.data(),
+        "held-frames", G_TYPE_UINT, heap.heldFrames, nullptr);
+    return context;
+}
+
+// A pool sized without the sink's held-frames could hand it fewer buffers than it keeps, so an answer
+// that lacks them counts as none.
+std::optional<DmaHeapContext> dmaHeapFromContext(GstContext* context)
+{
+    if (!context || !gst_context_has_context_type(context, WEBKIT_DMA_HEAP_CONTEXT_TYPE_NAME.characters()))
+        return std::nullopt;
+
+    const GstStructure* structure = gst_context_get_structure(context);
+    const char* device = gst_structure_get_string(structure, "device");
+    auto heldFrames = gstStructureGet<unsigned>(structure, "held-frames"_s);
+    if (!device || !heldFrames)
+        return std::nullopt;
+    return DmaHeapContext { CString(device), *heldFrames };
+}
+
+bool isDmaHeapContextQuery(GstQuery* query)
+{
+    const char* contextType;
+    if (GST_QUERY_TYPE(query) != GST_QUERY_CONTEXT || !gst_query_parse_context_type(query, &contextType))
+        return false;
+    return !g_strcmp0(contextType, WEBKIT_DMA_HEAP_CONTEXT_TYPE_NAME.characters());
+}
+
+// The system heap comes first: it needs no physically contiguous memory, which is scarce.
+Vector<CString> dmaHeapDevices()
+{
+    static constexpr auto heapDirectory = "/dev/dma_heap"_s;
+    static constexpr auto systemHeap = "system"_s;
+
+    auto names = FileSystem::listDirectory(heapDirectory);
+    std::ranges::sort(names, [&](const String& a, const String& b) {
+        if ((a == systemHeap) != (b == systemHeap))
+            return a == systemHeap;
+        return codePointCompareLessThan(a, b);
+    });
+
+    return names.map([&](const String& name) {
+        return FileSystem::pathByAppendingComponent(heapDirectory, name).utf8();
+    });
+}
+
+GRefPtr<GstAllocator> createDmaHeapAllocator(const CString& device)
+{
+    int heapFd = open(device.data(), O_RDWR | O_CLOEXEC);
+    if (heapFd < 0)
+        return nullptr;
+
+    GRefPtr<GstAllocator> allocator = GST_ALLOCATOR_CAST(g_object_new(webkit_dma_heap_allocator_get_type(), nullptr));
+    reinterpret_cast<WebKitDmaHeapAllocator*>(allocator.get())->priv->heapFd = heapFd;
+    GST_DEBUG_OBJECT(allocator.get(), "allocating from %s", device.data());
+    return allocator;
+}
+
+} // namespace WebCore
+
+#undef GST_CAT_DEFAULT
+
+#endif // USE(GSTREAMER) && OS(LINUX)
