+bool MediaSource::mediaKeysDecodeVideoType(Document& document, const String& type) const
+{
+#if ENABLE(ENCRYPTED_MEDIA)
+    RefPtr mediaElement = m_mediaElement.get();
+    if (!mediaElement)
+        return false;
+
+    RefPtr mediaKeys = mediaElement->mediaKeys();
+    if (!mediaKeys)
+        return false;
+
+    ContentType contentType(type);
+    return mediaKeys->decodesVideoContentType(contentType) && isTypeSupported(document, contentType.containerType());
+#else
+    UNUSED_PARAM(document);
+    UNUSED_PARAM(type);
+    return false;
+#endif
+}
