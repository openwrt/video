+
+bool MediaPlayerPrivateGStreamer::cdmDecodesVideo(const GstCaps* caps) const
+{
+    ASSERT(isMainThread());
+
+    if (!m_cdmInstance)
+        return false;
+
+    auto* structure = gst_caps_get_structure(caps, 0);
+    if (!structure || !gst_structure_has_name(structure, "application/x-cenc"))
+        return false;
+
+    auto protectionSystem = gstStructureGetString(structure, "protection-system"_s);
+    if (protectionSystem && !equalIgnoringASCIICase(protectionSystem.span(), GStreamerEMEUtilities::keySystemToUuid(m_cdmInstance->keySystem())))
+        return false;
+
+    return m_cdmInstance->decodesVideoMediaType(String::fromUTF8(capsMediaType(caps).span()));
+}
 #endif
 
