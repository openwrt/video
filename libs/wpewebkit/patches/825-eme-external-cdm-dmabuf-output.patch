+    uint8_t* data = picture.data();
+    for (size_t y = 0; y < chromaHeight; ++y) {
+        const uint8_t* u = data + uOffset + y * uStride;
+        const uint8_t* v = data + vOffset + y * vStride;
+        uint8_t* uv = data + uvOffset + y * uvStride;
