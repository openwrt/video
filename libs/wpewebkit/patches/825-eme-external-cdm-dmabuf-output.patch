+// The CDM may destroy a picture on any of its threads, and a later allocation may reuse its address, so a
+// picture leaves the registry before its memory is freed.
+class ExternalCDMPictureRegistration {
+    WTF_MAKE_NONCOPYABLE(ExternalCDMPictureRegistration);
+public:
+    ExternalCDMPictureRegistration(ExternalCDMPictures& pictures, cdm::Buffer& picture, CDMPictureMemory memory)
+        : m_pictures(pictures)
+        , m_picture(picture)
+    {
+        pictures.add(&picture, memory);
+    }
+
+    ~ExternalCDMPictureRegistration() { m_pictures->take(&m_picture); }
+
+private:
+    const Ref<ExternalCDMPictures> m_pictures;
+    cdm::Buffer& m_picture;
+};
