+// A dma-buf from the decoder's pool, mapped for the CDM or for the decoder to write the picture into. Its
+// capacity is the size the picture was asked for, which sizes the pool when the picture size changes.
+class ExternalCDMDmaBuffer final : public cdm::Buffer {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(ExternalCDMDmaBuffer);
+public:
+    static ExternalCDMDmaBuffer* create(GRefPtr<GstBuffer>&& buffer, size_t capacity)
+    {
+        auto* dmaBuffer = new ExternalCDMDmaBuffer(WTF::move(buffer), capacity);
+        if (!gst_buffer_map(dmaBuffer->m_buffer.get(), &dmaBuffer->m_map, GST_MAP_READWRITE)) {
+            delete dmaBuffer;
+            return nullptr;
+        }
+        dmaBuffer->m_isMapped = true;
+        return dmaBuffer;
+    }
+
+    ~ExternalCDMDmaBuffer() override { unmap(); }
+
+    void registerWith(ExternalCDMPictures& pictures) { m_registration.emplace(pictures, *this, CDMPictureMemory::DmaBuf); }
+
+    void Destroy() override { delete this; }
+    uint32_t Capacity() const override { return static_cast<uint32_t>(m_capacity); }
+    uint8_t* Data() override { return m_map.data; }
+    void SetSize(uint32_t size) override { m_size = size; }
+    uint32_t Size() const override { return m_size; }
+
+    std::span<uint8_t> mappedSpan() { return unsafeMakeSpan(m_map.data, m_map.size); }
+
+    GRefPtr<GstBuffer> takeBuffer()
+    {
+        unmap();
+        return WTF::move(m_buffer);
+    }
+
+private:
+    ExternalCDMDmaBuffer(GRefPtr<GstBuffer>&& buffer, size_t capacity)
+        : m_buffer(WTF::move(buffer))
+        , m_capacity(capacity)
+    {
+    }
+
+    void unmap()
+    {
+        if (!m_isMapped)
+            return;
+        gst_buffer_unmap(m_buffer.get(), &m_map);
+        m_isMapped = false;
+    }
+
+    GRefPtr<GstBuffer> m_buffer;
+    GstMapInfo m_map { };
+    std::optional<ExternalCDMPictureRegistration> m_registration;
+    bool m_isMapped { false };
+    size_t m_capacity;
+    uint32_t m_size { 0 };
+};
