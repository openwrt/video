+// GstVideoDecoder replaces its pool without a lock that other threads could take, so the decoder keeps its own
+// reference to the pool it negotiated.
+static GRefPtr<GstBufferPool> outputPool(WebKitExternalCDMVideoDecoder* self)
+{
+    Locker locker { self->priv->lock };
+    return self->priv->outputPool;
+}
+
+static void setOutputPool(WebKitExternalCDMVideoDecoder* self, GstBufferPool* pool)
+{
+    Locker locker { self->priv->lock };
+    self->priv->outputPool = pool;
+}
