+// The pictures the CDM holds. Pictures outlive the decoder when the CDM keeps them, so they share this with it.
+class ExternalCDMPictures final : public ThreadSafeRefCounted<ExternalCDMPictures> {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(ExternalCDMPictures);
+public:
+    static Ref<ExternalCDMPictures> create() { return adoptRef(*new ExternalCDMPictures); }
+
+    void add(cdm::Buffer* picture, CDMPictureMemory memory)
+    {
+        Locker locker { m_lock };
+        m_pictures.append({ picture, memory });
+    }
+
+    std::optional<CDMPictureMemory> take(cdm::Buffer* picture)
+    {
+        Locker locker { m_lock };
+        size_t index = m_pictures.findIf([picture](const auto& entry) {
+            return entry.picture == picture;
+        });
+        if (index == notFound)
+            return std::nullopt;
+        auto memory = m_pictures[index].memory;
+        m_pictures.removeAt(index);
+        return memory;
+    }
+
+    size_t size() const
+    {
+        Locker locker { m_lock };
+        return m_pictures.size();
+    }
+
+    size_t dmaBufCount() const
+    {
+        Locker locker { m_lock };
+        return std::ranges::count_if(m_pictures, [](const auto& entry) {
+            return entry.memory == CDMPictureMemory::DmaBuf;
+        });
+    }
+
+private:
+    struct Entry {
+        cdm::Buffer* picture;
+        CDMPictureMemory memory;
+    };
+
+    mutable Lock m_lock;
+    Vector<Entry> m_pictures WTF_GUARDED_BY_LOCK(m_lock);
+};
