+static void setOutputPoolFlushing(WebKitExternalCDMVideoDecoder* self, bool isFlushing)
+{
+    GRefPtr<GstBufferPool> pool = outputPool(self);
+    if (pool && gst_buffer_pool_is_active(pool.get()))
+        gst_buffer_pool_set_flushing(pool.get(), isFlushing);
+}
