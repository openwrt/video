+static bool canHoldPicture(const cdm::VideoDecoderConfig_3& config, uint32_t capacity)
+{
+    uint64_t lumaPlaneSize = static_cast<uint64_t>(std::max(config.coded_size.width, 0)) * std::max(config.coded_size.height, 0);
+    return capacity >= lumaPlaneSize;
+}
+
+// Runs on whichever CDM thread asks, while the decoder's CDM thread waits in DecryptAndDecodeFrame(); the
+// adapter's video output mutex orders it with that thread's accesses to config and reservedBuffers.
+cdm::Buffer* ExternalCDMVideoDecoderOutput::Allocate(uint32_t capacity)
+{
+    auto* priv = m_decoder->priv;
+    if (!canHoldPicture(priv->config, capacity))
+        return nullptr;
+
+    if (!priv->reservedBuffers.isEmpty() && capacity <= priv->dmaBufPictureSize) {
+        if (auto* buffer = ExternalCDMDmaBuffer::create(priv->reservedBuffers.takeLast(), capacity)) {
+            buffer->registerWith(priv->pictures.get());
+            return buffer;
+        }
+    }
+
+    return new ExternalCDMHeapPicture(capacity, priv->pictures.get());
+}
