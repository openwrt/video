+Vector<String> mimeCodecsFromCaps(GstCaps* caps)
+{
+#if GST_CHECK_VERSION(1, 20, 0)
+    auto mimeCodec = GMallocString::unsafeAdoptFromUTF8(gst_codec_utils_caps_get_mime_codec(caps));
+    if (!mimeCodec)
+        return { };
+
+    String codec(mimeCodec.span());
+    Vector<String> codecs { codec };
+    for (auto& [webMName, fourCC] : s_webMCodecNames) {
+        if (codec.startsWith(fourCC))
+            codecs.append(webMName);
+    }
+    return codecs;
+#else
+    UNUSED_PARAM(caps);
+    return { };
+#endif
+}
