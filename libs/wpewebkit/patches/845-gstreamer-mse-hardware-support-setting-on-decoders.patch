+void MediaPlayerPrivateGStreamer::updateContentTypesRequiringHardwareSupport()
+{
+    RefPtr player = m_player.get();
+    if (!player)
+        return;
+
+    Locker locker { m_contentTypesRequiringHardwareSupportLock };
+    m_contentTypesRequiringHardwareSupport = crossThreadCopy(player->mediaContentTypesRequiringHardwareSupport());
+}
+
+bool MediaPlayerPrivateGStreamer::isHardwareSupportRequired(const Vector<String>& codecs)
+{
+    Locker locker { m_contentTypesRequiringHardwareSupportLock };
+    const auto& contentTypes = m_contentTypesRequiringHardwareSupport;
+    return std::ranges::any_of(codecs, [&](auto& codec) {
+        return GStreamerRegistryScanner::isHardwareSupportRequired(contentTypes, String(), codec);
+    });
+}
+
+// Called from the streaming thread that adds the decoder. An encrypted stream goes to a decoder inside a CDM, which the
+// setting does not cover.
+void MediaPlayerPrivateGStreamer::refuseSoftwareDecodingRequiringHardware(GstElement* decoder)
+{
+    auto* factory = gst_element_get_factory(decoder);
+    if (!factory || GStreamerRegistryScanner::isFactoryUsingHardware(factory))
+        return;
+
+    GRefPtr sinkPad = adoptGRef(gst_element_get_static_pad(decoder, "sink"));
+    auto probe = PadProbeHandle<MediaPlayerPrivateGStreamer>::create(*this, WTF::move(sinkPad), GST_PAD_PROBE_TYPE_EVENT_DOWNSTREAM, [](const auto& player, const auto& pad, auto info) -> GstPadProbeReturn {
+        auto* event = gst_pad_probe_info_get_event(info);
+        if (GST_EVENT_TYPE(event) != GST_EVENT_CAPS)
+            return GST_PAD_PROBE_OK;
+
+        GstCaps* caps;
+        gst_event_parse_caps(event, &caps);
+        if (areEncryptedCaps(caps))
+            return GST_PAD_PROBE_REMOVE;
+
+        auto codecs = mimeCodecsFromCaps(caps);
+        if (!player->isHardwareSupportRequired(codecs))
+            return GST_PAD_PROBE_OK;
+
+        GRefPtr decoder = adoptGRef(gst_pad_get_parent_element(pad.get()));
+        GST_ELEMENT_ERROR(decoder.get(), STREAM, CODEC_NOT_FOUND, ("Decoding %s in software is not allowed", codecs.first().utf8().data()),
+            ("%s takes no hardware", GST_ELEMENT_NAME(decoder.get())));
+        return GST_PAD_PROBE_DROP;
+    });
+
+    Locker locker { m_decoderConfigurationLock };
+    m_hardwareSupportProbes.append(WTF::move(probe));
+}
+
 void MediaPlayerPrivateGStreamer::configureVideoDecoder(GstElement* decoder)
 {
     leaveHolePunchForSoftwareDecoder(decoder);
 
+    if (isMediaSource())
+        refuseSoftwareDecodingRequiringHardware(decoder);
+
     auto name = GMallocString::unsafeAdoptFromUTF8(gst_element_get_name(decoder));
     if (startsWith(name.span(), "v4l2"_s))
         m_videoDecoderPlatform = GstVideoDecoderPlatform::Video4Linux;
