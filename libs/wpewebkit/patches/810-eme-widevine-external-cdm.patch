+uint32_t CDMInstanceExternalCDM::registerPromise(PromiseCallback&& callback)
+{
+    ASSERT(isMainThread());
+    uint32_t promiseId = nextPromiseId();
+    m_pendingPromises.add(promiseId, WTF::move(callback));
+    return promiseId;
