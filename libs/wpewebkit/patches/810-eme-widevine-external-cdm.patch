+cdm::Time CdmAdapter::GetCurrentWallTime()
+{
+  cdm::Time res = static_cast<cdm::Time>(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count());
+  return res / 1000.0;
+}
