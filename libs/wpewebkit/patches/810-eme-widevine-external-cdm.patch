+void CdmAdapter::CloseSession(uint32_t promise_id,
+  const char* session_id,
+  uint32_t session_id_size)
+{
+  std::vector<std::future<void>> closingTimers;
+  {
+    std::lock_guard<std::mutex> lock(m_closeSessionMutex);
+    m_isClosingSession = true;
+    // Take the pending timers so they can be released below without a CDM lock
+    // held: a timer already in TimerExpired waits for decrypt_mutex_, so
+    // blocking on its future while holding that lock would deadlock.
+    closingTimers.swap(m_asyncTimerTasks);
+  }
+  m_sessionClosingCond.notify_all();
+
+  {
+    std::lock_guard<std::mutex> lock(decrypt_mutex_);
+    if (cdm12_)
+      cdm12_->CloseSession(promise_id, session_id, session_id_size);
+    else if (cdm11_)
+      cdm11_->CloseSession(promise_id, session_id, session_id_size);
+    else if (cdm10_)
+      cdm10_->CloseSession(promise_id, session_id, session_id_size);
+  }
+
+  // Release the taken timers with no CDM lock held. The closing flag is still
+  // set, so a timer still in its wait drops at once; one already in
+  // TimerExpired can take decrypt_mutex_ and finish, since we hold nothing.
+  closingTimers.clear();
+
+  // The flag only cancels timers queued across this close; leaving it set would
+  // drop every later timer, so the session that reuses these MediaKeys stalls.
+  {
+    std::lock_guard<std::mutex> lock(m_closeSessionMutex);
+    m_isClosingSession = false;
+  }
+}
