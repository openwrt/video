+// The ITU-T H.273 range equations for bitDepth-bit codes in the top bits of sampleBits-bit samples.
+static constexpr std::array<GLfloat, 16> yuvToRgbConversionMatrix(LumaCoefficients coefficients, CoordinatedPlatformLayerBufferYUV::SampleRange sampleRange, unsigned bitDepth, unsigned sampleBits)
+{
+    double kr = coefficients.kr;
+    double kb = coefficients.kb;
+    double kg = 1 - kr - kb;
+    double codesPerSample = ((1u << sampleBits) - 1) / static_cast<double>(1u << (sampleBits - bitDepth));
+
+    double lumaScale;
+    double lumaOffset;
+    double chromaScale;
+    double chromaOffset;
+    if (sampleRange == CoordinatedPlatformLayerBufferYUV::SampleRange::Full) {
+        double maxCode = (1u << bitDepth) - 1;
+        lumaScale = codesPerSample / maxCode;
+        lumaOffset = 0;
+        chromaScale = lumaScale;
+        chromaOffset = (1u << (bitDepth - 1)) / maxCode;
+    } else {
+        double codeStep = 1u << (bitDepth - 8);
+        lumaScale = codesPerSample / (codeStep * 219);
+        lumaOffset = 16.0 / 219;
+        chromaScale = codesPerSample / (codeStep * 224);
+        chromaOffset = 128.0 / 224;
+    }
+
+    double crToR = 2 * (1 - kr);
+    double cbToG = -2 * kb * (1 - kb) / kg;
+    double crToG = -2 * kr * (1 - kr) / kg;
+    double cbToB = 2 * (1 - kb);
+
+    return {
+        static_cast<GLfloat>(lumaScale), 0, static_cast<GLfloat>(crToR * chromaScale), static_cast<GLfloat>(-lumaOffset - crToR * chromaOffset),
+        static_cast<GLfloat>(lumaScale), static_cast<GLfloat>(cbToG * chromaScale), static_cast<GLfloat>(crToG * chromaScale), static_cast<GLfloat>(-lumaOffset - (cbToG + crToG) * chromaOffset),
+        static_cast<GLfloat>(lumaScale), static_cast<GLfloat>(cbToB * chromaScale), 0, static_cast<GLfloat>(-lumaOffset - cbToB * chromaOffset),
+        0, 0, 0, 1,
     };
+}
 
