     void leaveHolePunchOnSystemMemoryOutput(GstElement* decoder);
     void leaveHolePunch(GstElement* decoder);
     void pushNextHolePunchBuffer(IsInitialBuffer = IsInitialBuffer::No);
+    void watchHolePunchVideoSize();
+    bool holePunchPlacesVideoByObjectFit() const;
     bool shouldIgnoreIntrinsicSize() final;
 
 #if USE(GSTREAMER_GL)
--- a/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkKodi.h
