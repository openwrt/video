From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joerg Bornemann <joerg.bornemann@qt.io>
Date: Thu, 25 Sep 2025 07:55:51 +0200
Subject: [PATCH] Re-enable the build of kmap2qmap

The tool is still documented but was never properly ported to Qt6.

Change-Id: Icad05a0c3648354bea0f423a1c5dcb1bbb287c4e
Reviewed-by: Oliver Wolff <oliver.wolff@qt.io>
(cherry picked from commit 620cb3381d7d39744e27e771d8364f967c369761)

[backport to 6.9: CMakeLists.txt find_package() context adjusted, QuickLayouts is
 not among the optional components in 6.9]

Signed-off-by: Mirko Vogt <foss@mirko.in>
---
 CMakeLists.txt         |   2 +-
 configure.cmake        |   3 +-
 src/CMakeLists.txt     |   3 +
 src/kmap2qmap/main.cpp | 140 ++++++++++++++++++++---------------------
 4 files changed, 76 insertions(+), 72 deletions(-)

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -20,7 +20,7 @@ endif()
 
 find_package(Qt6 ${PROJECT_VERSION} CONFIG REQUIRED COMPONENTS BuildInternals Core)
 find_package(Qt6 ${PROJECT_VERSION} QUIET CONFIG OPTIONAL_COMPONENTS
-             DBus Network Xml Widgets Quick QuickWidgets Qml QmlLSPrivate
+             DBus InputSupportPrivate Network Xml Widgets Quick QuickWidgets Qml QmlLSPrivate
              Sql PrintSupport OpenGL OpenGLWidgets ${optional_components})
 qt_internal_project_setup()
 
--- a/configure.cmake
+++ b/configure.cmake
@@ -62,6 +62,7 @@ qt_feature("distancefieldgenerator" PRIV
 qt_feature("kmap2qmap" PRIVATE
     LABEL "kmap2qmap"
     PURPOSE "kmap2qmap is a tool to generate keymaps for use on Embedded Linux. The source files have to be in standard Linux kmap format that is e.g. understood by the kernel's loadkeys command."
+    CONDITION TARGET Qt::InputSupportPrivate
 )
 qt_feature("linguist" PRIVATE
     LABEL "Qt Linguist"
@@ -102,7 +103,7 @@ qt_configure_add_summary_entry(ARGS "cla
 qt_configure_add_summary_entry(ARGS "clangcpp")
 qt_configure_add_summary_entry(ARGS "designer")
 qt_configure_add_summary_entry(ARGS "distancefieldgenerator")
-#qt_configure_add_summary_entry(ARGS "kmap2qmap")
+qt_configure_add_summary_entry(ARGS "kmap2qmap")
 qt_configure_add_summary_entry(ARGS "linguist")
 qt_configure_add_summary_entry(ARGS "pixeltool")
 qt_configure_add_summary_entry(ARGS "qdbus")
