#!/bin/sh /etc/rc.common

START=98
USE_PROCD=1
PROG=/usr/sbin/webkit-contentfilter
PUBLISH_DIR=/var/run/webkit-contentfilter
CLOCK_SYNCED=/var/run/webkit-contentfilter.clock

clock_valid() {
	[ -e "$CLOCK_SYNCED" ] || [ "$(uci -q get system.ntp.enabled)" = 0 ]
}

storage_mounted() {
	local mountpoint

	[ -n "$1" ] || return 0
	mountpoint="$(procd_get_mountpoints "$1")"
	[ -z "$mountpoint" ] || grep -q ".* $mountpoint " /proc/mounts
}

start_service() {
	local storage

	# web views watch the directory, so it exists before they start
	mkdir -p "$PUBLISH_DIR"

	config_load webkit-contentfilter
	config_get storage global storage
	storage_mounted "$storage" || return 0

	procd_open_instance
	if clock_valid; then
		procd_set_param command "$PROG" --fetch
	else
		procd_set_param command "$PROG"
	fi
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	local storage

	config_load webkit-contentfilter
	config_get storage global storage

	procd_add_reload_trigger webkit-contentfilter
	[ -n "$storage" ] && procd_add_action_mount_trigger start "$storage"
}

reload_service() {
	restart
}
