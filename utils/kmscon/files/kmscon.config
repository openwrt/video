config kmscon 'main'
	option term 'xterm-256color'
	option font_size '14'
	# Unset picks unifont if kmscon-mod-unifont is installed, else the
	# built-in 8x16, which renders ASCII only.
	option font_engine ''
	option hwaccel '1'
	option login '/bin/login -p'
	# Seat to run on, or leave unset for seat0.
	option seats ''
